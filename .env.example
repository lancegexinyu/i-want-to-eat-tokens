# 这是例子。里面没有真密钥。程序不会自动读取这个文件。
# Example only. There is no real key here. This program does not load .env by itself.
#
# 只导出你自己的、你打算用来烧掉的那一把密钥。不要写别人的密钥。
# Export only your own key, the one you intend to burn. Never put someone else's key here.

# 通用：任何服务商都会优先用它（比下面的专用变量优先）。
# Generic: used first for every provider, ahead of the provider-specific variable.
EAT_TOKENS_API_KEY=your-own-key-here

# DeepSeek（默认服务商 / the default provider）
DEEPSEEK_API_KEY=your-own-key-here

# OpenAI
OPENAI_API_KEY=your-own-key-here

# Codex 风格。没设的话会退回 OPENAI_API_KEY。
# Codex-style. If unset, the tool falls back to OPENAI_API_KEY.
CODEX_API_KEY=your-own-key-here

# xAI Grok
XAI_API_KEY=your-own-key-here

# Anthropic Claude
ANTHROPIC_API_KEY=your-own-key-here

# 可选。命令行参数盖过这些变量。上限不从环境变量读，避免一个旧变量把帽摘掉。
# Optional. Flags win. Caps are not read from the environment.
# EAT_TOKENS_PROVIDER=deepseek
# EAT_TOKENS_BASE_URL=https://api.deepseek.com
# EAT_TOKENS_MODEL=deepseek-flash
